# Configuration for ad_policy + proxy.
#
# Run ./setup.sh to be asked each of these questions and have .env written
# for you. The text above each variable is the question; the "#!" lines are
# directives the wizard understands (required, secret, type, choices, when,
# generate, advanced). Copy this file to .env by hand if you prefer.

#! section: Active Directory

# Hostname or IP address of a domain controller. The container must be able
# to reach it on the port below.
#! required
#! type: hostname
LDAP_HOST=

# LDAP port. 636 is LDAPS (recommended); 389 is unencrypted LDAP.
#! type: int
LDAP_PORT=636

# Use LDAPS (TLS). Keep this on unless the port above is 389.
#! type: bool
LDAP_USE_SSL=true

# Verify the domain controller's certificate. When on, copy the CA
# certificate that issued it to certs/ad-ca.pem before continuing.
#! type: bool
LDAP_VALIDATE_CERT=false

# Service account used to bind and search. Read-only is enough. Use the form
# DOMAIN\user or user@domain.example.com.
#! required
LDAP_USER=

# Password for the service account.
#! required
#! secret
LDAP_PASSWORD=

# Subtree to search. Users outside it are not found.
#! required
LDAP_BASE_DN=DC=example,DC=com

#! section: Mattermost (optional)

# Policy URL shown in the Pexip Mattermost plugin's settings, for example
# https://mattermost.example.com/plugins/com.pexip.pexip-app/api/
# Leave blank if you do not use Mattermost.
#! type: url
MATTERMOST_POLICY_URL=

#! section: Pexip policy credentials

# Pexip sends one username and password with every policy request, and this
# server checks them. If you use Mattermost these MUST be the username and
# password generated by the Mattermost plugin. Otherwise choose any username
# and accept the generated password.
#! required
POLICY_USER=pexip

# Password Pexip will send. A random one is offered when none is set.
#! required
#! secret
#! generate: password
POLICY_PASSWORD=

#! section: TLS for the policy endpoint

# How Pexip reaches this server:
#   self-signed  generate a certificate on first start; upload
#                certs/proxy/fullchain.pem to Pexip afterwards
#   provided     use your own certs/proxy/fullchain.pem and privkey.pem
#   off          plain HTTP on port 80 (only behind something that does TLS)
#! choices: self-signed|provided|off
TLS_MODE=self-signed

# DNS name (or IP) the Conferencing Nodes will use to reach this server. It
# goes into the generated certificate and the Pexip policy profile URL.
#! required
#! when: TLS_MODE=self-signed
#! type: hostname
PROXY_HOSTNAME=policy.example.com

#! section: Advanced

# Seconds to cache lookups, hits and misses alike. 0 disables the cache.
#! advanced
#! type: int
AVATAR_CACHE_TTL=300

# Log raw participant identities instead of hashes. Debugging only.
#! advanced
#! type: bool
LOG_PII=false

# Largest avatar edge Pexip may request, in pixels.
#! advanced
#! type: int
AVATAR_MAX_DIMENSION=512
